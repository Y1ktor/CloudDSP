# Public OIDC metadata for the local Keycloak browser client. Vite embeds every
# VITE_* value in the browser bundle, so none of these values is a secret.
VITE_OIDC_ISSUER=http://keycloak.localhost:8080/realms/clouddsp
VITE_OIDC_CLIENT_ID=clouddsp-react
VITE_OIDC_REDIRECT_URI=http://clouddsp.localhost:8080/
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://clouddsp.localhost:8080/

# Browser-facing local application endpoints. The API and realtime services do
# not exist yet, so leave them blank rather than guessing a Kubernetes DNS name:
# browser JavaScript cannot resolve ClusterIP Service DNS names directly.
VITE_JOB_API_URL=
VITE_WEBSOCKET_URL=

# Optional local demo-asset origin. Do not put a private storage credential or
# presigned URL here; the eventual API will issue short-lived artifact URLs.
VITE_DEMO_ASSET_ORIGIN=
