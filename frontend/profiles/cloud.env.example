# Copy to frontend/.env.cloud.local. VITE values are public browser settings,
# embedded into the cloud build; never add passwords, API keys, or credentials.
# Obtain these identifiers and endpoints from the cloud stack outputs.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_BROWSER_CLIENT_ID=
VITE_JOB_API_URL=
VITE_WEBSOCKET_URL=

# Optional HTTPS origin proxied as same-origin /demo during Vite development.
VITE_DEMO_ASSET_ORIGIN=
