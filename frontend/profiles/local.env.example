# Copy to frontend/.env.k8.local. Vite reserves the name "local" for environment
# file suffixes, so its build mode is k8 while the product profile is local.
# These are public browser settings, never service/admin credentials.
VITE_OIDC_ISSUER=http://keycloak.localhost:8080/realms/clouddsp
VITE_OIDC_CLIENT_ID=clouddsp-react
VITE_OIDC_REDIRECT_URI=http://clouddsp.localhost:8080/
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://clouddsp.localhost:8080/
VITE_JOB_API_URL=http://clouddsp.localhost:8080
# The current local API uses polling. Leave this blank until a local WebSocket
# service and its browser-facing route are installed.
VITE_WEBSOCKET_URL=
VITE_OBJECT_STORAGE_URL=http://minio.localhost:8080

# Optional HTTPS origin proxied as same-origin /demo during Vite development.
VITE_DEMO_ASSET_ORIGIN=
