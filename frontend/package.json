{
  "name": "clouddsp-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode cloud",
    "dev:cloud": "vite --mode cloud",
    "dev:local": "vite --mode k8",
    "build": "npm run build:cloud",
    "build:cloud": "vite build --mode cloud",
    "build:local": "vite build --mode k8",
    "lint": "oxlint",
    "test": "node --test \"tests/**/*.test.js\" \"src/**/*.test.js\"",
    "test:auth": "node --test src/auth/*.test.js src/platform/local/*.test.js",
    "preview": "vite preview --mode cloud",
    "preview:local": "vite preview --mode k8"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "amazon-cognito-identity-js": "^6.3.20",
    "jszip": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "smplr": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "vite": "^8.1.0"
  }
}
